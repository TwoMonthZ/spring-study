<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!--
        引入外部bean
        1、创建两个类对象：dept和emp
        2、在emp的bean标签里，使用property
     -->
    <bean id="dept" class="com.rly.springiocxml.ditest.Dept">
        <property name="dname" value="安保部门"/>
    </bean>
    <bean id="emp" class="com.rly.springiocxml.ditest.Emp">
        <!--属性注入-->
        <property name="ename" value="张三"></property>
        <property name="age" value="18"></property>
        <!--对象类型属性注入-->
        <property name="dept" ref="dept"></property>
    </bean>

    <!--
      内部bean
      1、创建两个类对象：dept和emp
      2、在emp的bean标签里，使用property
      3.property中使用bean
   -->
    <bean id="emp2" class="com.rly.springiocxml.ditest.Emp">
        <!--属性注入-->
        <property name="ename" value="李四"></property>
        <property name="age" value="20"></property>
        <property name="dept">
            <!-- 内部bean -->
            <bean id="dept2" class="com.rly.springiocxml.ditest.Dept">
                <property name="dname" value="开发部门"/>
            </bean>
        </property>
    </bean>

    <!--
    级联赋值
    -->
    <bean id="dept3" class="com.rly.springiocxml.ditest.Dept">
        <property name="dname" value="技术部门"/>
    </bean>
    <bean id="emp3" class="com.rly.springiocxml.ditest.Emp">
        <!--属性注入-->
        <property name="ename" value="王五"></property>
        <property name="age" value="25"></property>
        <property name="dept" ref="dept3"></property>
        <property name="dept.dname" value="测试部门"></property>
    </bean>

</beans>