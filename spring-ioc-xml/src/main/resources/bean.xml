<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!--   1、完成User对象创建bean标签
            id: bean的id，唯一标识
            class: bean的全限定名
            按类名会报错，有多个id
    -->
    <bean id="user" class="com.rly.springiocxml.User"/>
    <bean id="user1" class="com.rly.springiocxml.User"/>

    <!--
          2、接口实现类获取bean
          实现单个接口的时候，可以获取到bean
          但实现多个接口的时候，获取bean会报错
    -->
    <bean id="userDao" class="com.rly.springiocxml.bean.UserDaoImpl"/>
    <bean id="personDao" class="com.rly.springiocxml.bean.PersonDaoImpl"/>
</beans>