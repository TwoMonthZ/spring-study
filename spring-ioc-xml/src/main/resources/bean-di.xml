<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">


    <!--
        1、set方法注入
    -->
    <bean id="book" class="com.rly.springiocxml.di.Book">
        <property name="bname" value="西游记"></property>
        <property name="author" value="尚硅谷"></property>
    <!--    <property name="others">
            <null></null>
        </property>-->
 <!--       <property name="others" value="&lt;&gt;"></property>-->
        <property name="others">
            <value><![CDATA[a<b]]></value>
        </property>
    </bean>
    <!--
        2、构造方法注入
    -->
    <bean id="bookCon" class="com.rly.springiocxml.di.Book">
        <constructor-arg name="bname" value="大话西游"></constructor-arg>
        <constructor-arg index="1" value="吴承恩"></constructor-arg>
    </bean>
</beans>